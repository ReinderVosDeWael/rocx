    "RangeId": "Checked string wrapper; validateAuthoringId",
    "RawFieldInstruction": "Mapped through FieldInstruction.Raw",
    "RelationshipId": "Low-level OPC toolkit",
    "RelationshipType": "Low-level OPC toolkit",
    "ResolvedBlock": "Untyped discriminant on paragraph/table handles; check their projections and reuse independently",
    "Rule": "Stable diagnostic code string on Error",
    "StoryId": "Rust identity allocation primitive",
    "StoryKind": "Low-level OPC toolkit",
    "StyleId": "Checked string wrapper; validateAuthoringId",
    "Target": "Low-level OPC toolkit",
