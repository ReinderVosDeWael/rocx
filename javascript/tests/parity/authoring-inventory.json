    "rocx::opc::",
    "rocx::template::"
  ],
  "records": {
    "BlockContentControl": "BlockContentControlDeclaration",
    "Break": "BreakDeclaration",
    "ColumnChartRun": "ColumnChartRunDeclaration",
    "Comment": "CommentDeclaration",
    "Document": "DocumentProgram",
    "Field": "FieldDeclaration",
    "Footer": "FooterDeclaration",
    "Header": "HeaderDeclaration",
    "Hyperlink": "HyperlinkDeclaration",
    "ImageRun": "ImageRunDeclaration",
    "InlineContentControl": "InlineContentControlDeclaration",
    "InlineFraction": "InlineFractionDeclaration",
    "Note": "NoteDeclaration",
    "NoteReference": "NoteReferenceDeclaration",
    "Paragraph": "ParagraphDeclaration",
